{
  "name": "Centurion Light",
  "type": "light",
  "tokenColors": [
    {
      "name": "JSON Property Key",
      "scope": [
        "support.type.property-name.json",
        "string.quoted.double.json meta.object.member.json"
      ],
      "settings": {
        "foreground": "#0073bd"
      }
    },
    {
      "name": "JSON String",
      "scope": [
        "string.quoted.double.json"
      ],
      "settings": {
        "foreground": "#bd4700"
      }
    },
    {
      "name": "JSON Number",
      "scope": [
        "constant.numeric.json"
      ],
      "settings": {
        "foreground": "#7300bd"
      }
    },
    {
      "name": "JSON Null",
      "scope": [
        "constant.language.json",
        "constant.language.null.json"
      ],
      "settings": {
        "foreground": "#00bd2b"
      }
    },
    {
      "name": "JSON Punctuation - Comma",
